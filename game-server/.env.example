SWORDVERSE_DB_NAME=swordverse_dev
SWORDVERSE_DB_USERNAME=postgres
SWORDVERSE_DB_PASSWORD=replace-with-local-password

SWORDVERSE_AUTH_ISSUER=swordverse
SWORDVERSE_AUTH_AUDIENCE=swordverse-game-server
SWORDVERSE_AUTH_SIGNING_KEY_BASE64=replace-with-valid-base64
SWORDVERSE_AUTH_ACCESS_TOKEN_TTL=15m
SWORDVERSE_AUTH_REFRESH_TOKEN_TTL=30d
SWORDVERSE_AUTH_REFRESH_COOKIE_SECURE=false
SWORDVERSE_AUTH_REFRESH_COOKIE_SAME_SITE=Strict

SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
